# Hustle HQ — sağlayıcı anahtarları. Bu dosyayı .env olarak kopyala ya da oyun içinden
# Yönetim > Motorlar ekranından gir. Boş bırakılan sağlayıcı atlanır.
# Hiçbiri yoksa ofis DEMO modunda (sahte ama canlı) çalışır.

PORT=3777
LANG=en

# Aynı anda en fazla kaç LLM çağrısı yapılsın (ücretsiz kotaları korur)
MAX_CONCURRENT=3
# Ajan tick aralığı (saniye)
TICK_SECONDS=25
# Demo modunu zorla (1) — anahtar olsa bile mock kullanır
FORCE_DEMO=0

# --- Ücretsiz / ücretsiz katmanlı sağlayıcılar ---
# https://openrouter.ai/keys  (':free' modeller: DeepSeek, Kimi K2, Qwen3, Llama, GLM)
OPENROUTER_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://z.ai/manage-apikey/apikey-list  (Zhipu uluslararası; GLM Flash süresiz ücretsiz, kart yok)
ZAI_API_KEY=
# https://open.bigmodel.cn  (glm-4-flash ücretsiz, Çin telefon numarası ister)
ZHIPU_API_KEY=
# https://cloud.siliconflow.cn  (ücretsiz Qwen/GLM modelleri)
SILICONFLOW_API_KEY=

# --- Çok ucuz / hediye kredili ---
# https://platform.deepseek.com
DEEPSEEK_API_KEY=
# https://platform.moonshot.ai  (Kimi)
MOONSHOT_API_KEY=
# https://dashscope-intl.aliyuncs.com  (Qwen)
DASHSCOPE_API_KEY=

# --- Lokal ---
# Ollama kuruluysa otomatik algılanır
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Claude masası (sadece sen tetikleyince): günlük üst sınır
CLAUDE_DAILY_LIMIT=10

# Lemon Squeezy (gerçek satışları OKUR, otomatik gelir kaydı). app.lemonsqueezy.com > Settings > API
LEMONSQUEEZY_API_KEY=
